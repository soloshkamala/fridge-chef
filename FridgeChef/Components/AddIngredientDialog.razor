@using FridgeChef.Models
@using Microsoft.Extensions.Localization
@using System.Globalization
@inject IStringLocalizer<FridgeChef.Resources.SharedResource> Localizer

<MudDialog Class="ingredient-dialog" Options="@(new DialogOptions { BackdropClick = false })">
    <TitleContent>
        <MudText Typo="Typo.h6">@Ingredient.Name</MudText>
    </TitleContent>
    <DialogContent>
        <EditForm Model="@model" OnValidSubmit="Add">

            <MudNumericField T="double"
                             @bind-Value="model.Quantity"
                             Label="@Localizer["QuantityLabel"]"
                             Culture="@CultureInfo.CurrentCulture"
                             Error="@(ValidateQuantity(model.Quantity) != null)"
                             ErrorText="@ValidateQuantity(model.Quantity)"
                             Immediate="true"
                             Variant="Variant.Outlined"
                             Class="mb-4" />


            <MudSelect T="string"
                       @bind-Value="model.Unit"
                       Label="@Localizer["UnitLabel"]"
                       Validation="@(new Func<string, string?>(ValidateUnit))"
                       ToStringFunc="GetUnitTranslation"
                       Variant="Variant.Outlined">
                @foreach (var allowedUnit in Ingredient.AllowedUnits)
                {
                    <MudSelectItem T="string" Value="@allowedUnit">
                        @GetUnitTranslation(allowedUnit)
                    </MudSelectItem>
                }
            </MudSelect>

            <MudButton Color="Color.Primary"
                       Variant="Variant.Filled"
                       ButtonType="ButtonType.Submit"
                       Class="mt-3">
                @(IsEditing? Localizer["SaveButton"].Value : Localizer["AddButton"].Value)
            </MudButton>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@Localizer["CancelButton"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public Ingredient Ingredient { get; set; } = new();

    [Parameter]
    public FridgeItem? EditingItem { get; set; }

    private bool IsEditing => EditingItem != null;

    private AddIngredientModel model = new();

    protected override void OnParametersSet()
    {
        if (EditingItem != null)
        {
            model.Quantity = EditingItem.Quantity;
            model.Unit = EditingItem.Unit;
        }
        else if (Ingredient.AllowedUnits.Count > 0)
        {
            model.Unit = Ingredient.AllowedUnits[0];
        }
    }

    private string? ValidateQuantity(double quantity)
    {
        return quantity > 0 && !double.IsNaN(quantity) && !double.IsInfinity(quantity)
            ? null
            : Localizer["QuantityGreaterThanZero"].Value;
    }

    private string? ValidateUnit(string? unit)
    {
        return !string.IsNullOrWhiteSpace(unit) && Ingredient.AllowedUnits.Contains(unit)
            ? null
            : Localizer["UnitRequired"].Value;
    }

    private void Add()
    {
        if (ValidateQuantity(model.Quantity) != null ||
            ValidateUnit(model.Unit) != null)
        {
            return;
        }

        var result = new FridgeItem
        {
            Id = EditingItem?.Id ?? 0,
            Ingredient = Ingredient,
            Quantity = model.Quantity,
            Unit = model.Unit ?? ""
        };

        MudDialog.Close(DialogResult.Ok(result));
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private string GetUnitTranslation(string unit) => unit switch
    {
        "шт" => Localizer["UnitPieces"].Value,
        "мл" => Localizer["UnitMilliliters"].Value,
        "л" => Localizer["UnitLiters"].Value,
        "г" => Localizer["UnitGrams"].Value,
        "кг" => Localizer["UnitKilograms"].Value,
        _ => unit
    };
}
