@using FridgeChef.Models

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            @Ingredient.Name
        </MudText>
    </TitleContent>

    <DialogContent>
        <EditForm Model="@model" OnValidSubmit="Add">
    <DataAnnotationsValidator />

        <MudNumericField T="double"
                         @bind-Value="model.Quantity"
                             For="@(() => model.Quantity)"
                         Label="Кількість"
                         Variant="Variant.Outlined"
                         Class="mb-4" />

        <MudSelect T="string"
                   @bind-Value="model.Unit"
                       For="@(() => model.Unit)"
                   Label="Одиниця вимірювання"
                   Variant="Variant.Outlined">

            @foreach (var allowedUnit in Ingredient.AllowedUnits)
            {
                <MudSelectItem T="string"
                               Value="@allowedUnit">
                    @allowedUnit
                </MudSelectItem>
            }

        </MudSelect>
            <MudButton Color="Color.Primary"
                       Variant="Variant.Filled"
                       ButtonType="ButtonType.Submit"
                       Class="mt-3">
                Додати
            </MudButton>
        </EditForm>

    </DialogContent>

    <DialogActions>

        <MudButton OnClick="Cancel">
            Скасувати
        </MudButton>

        

    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public Ingredient Ingredient { get; set; } = new();

    private AddIngredientModel model = new();

    protected override void OnParametersSet()
    {
        if (Ingredient.AllowedUnits.Count > 0)
        {
            model.Unit = Ingredient.AllowedUnits[0];
        }
    }

    private void Add()
    {
        var result = new FridgeItem
        {
            Ingredient = Ingredient,
            Quantity = model.Quantity,
            Unit = model.Unit ?? ""
        };

        MudDialog.Close(DialogResult.Ok(result));
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }
}