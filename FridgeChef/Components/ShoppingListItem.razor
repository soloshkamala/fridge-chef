@using FridgeChef.Models
@using FridgeChef.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<ShoppingListResource> L

<div class="product-row">

    <MudCheckBox T="bool"
                 Value="@Item.IsPurchased"
                 ValueChanged="PurchasedChanged" />

    <MudText Class="product-name">
        @Item.Name
    </MudText>

    <div class="product-status">
        <MudCheckBox T="bool"
                     Value="@Item.IsInFridge"
                     ValueChanged="FridgeChanged"
                     Label="@L["InFridge"]" />
    </div>

    <MudText Class="product-quantity">
        @Item.Quantity @GetUnitName(Item.Unit)
    </MudText>

</div>

@code {
    [Parameter]
    public ShoppingItem Item { get; set; } = new();

    [Parameter]
    public EventCallback<ShoppingItem> OnPurchasedChanged { get; set; }

    [Parameter]
    public EventCallback<ShoppingItem> OnFridgeChanged { get; set; }

    private string GetUnitName(string unit)
    {
        return unit switch
        {
            "кг" => L["UnitKg"].Value,
            "шт." => L["UnitPieces"].Value,
            "л" => L["UnitLiters"].Value,
            _ => unit
        };
    }

    private async Task PurchasedChanged(bool value)
    {
        Item.IsPurchased = value;
        await OnPurchasedChanged.InvokeAsync(Item);
    }

    private async Task FridgeChanged(bool value)
    {
        Item.IsInFridge = value;
        await OnFridgeChanged.InvokeAsync(Item);
    }
}
