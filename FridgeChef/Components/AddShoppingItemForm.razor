@using FridgeChef.Models
@using Microsoft.AspNetCore.Components.Forms
@using FridgeChef.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<ShoppingListResource> L

<MudPaper Class="add-product-form" Elevation="0">

    <MudText Typo="Typo.h6" Class="form-title">
        @L["AddProduct"]
    </MudText>

    <EditForm Model="@Model" OnValidSubmit="Submit">
        <DataAnnotationsValidator />

        <MudTextField T="string"
                      Label="@L["ProductName"]"
                      @bind-Value="Model.Name"
                      For="@(() => Model.Name)"
                      Variant="Variant.Outlined"
                      Required="true"
                      Class="form-field" />

        <MudNumericField T="double?"
                         Label="@L["Quantity"]"
                         @bind-Value="Model.Quantity"
                         For="@(() => Model.Quantity)"
                         Variant="Variant.Outlined"
                         Class="form-field" />

        <MudSelect T="string"
                   Label="@L["Unit"]"
                   @bind-Value="Model.Unit"
                   For="@(() => Model.Unit)"
                   Variant="Variant.Outlined"
                   Class="form-field">

            <MudSelectItem T="string" Value="@("кг")">кг</MudSelectItem>
            <MudSelectItem T="string" Value="@("шт.")">шт.</MudSelectItem>
            <MudSelectItem T="string" Value="@("л")">л</MudSelectItem>

        </MudSelect>

        <MudSelect T="string"
                   Label="@L["Category"]"
                   @bind-Value="Model.Category"
                   For="@(() => Model.Category)"
                   Variant="Variant.Outlined"
                   Class="form-field">

            <MudSelectItem T="string" Value="@("Овочі та фрукти")">
                @L["FruitsVegetables"]
            </MudSelectItem>

            <MudSelectItem T="string" Value="@("М'ясо та птиця")">
                @L["MeatPoultry"]
            </MudSelectItem>

        </MudSelect>

        <div class="form-buttons">

            <MudButton ButtonType="ButtonType.Button"
                       Variant="Variant.Text"
                       OnClick="Cancel">
                @L["Cancel"]
            </MudButton>

            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       Class="save-product-button">
                @L["Add"]
            </MudButton>

        </div>

    </EditForm>

</MudPaper>

@code {
    private ShoppingItemForm Model = new();

    [Parameter]
    public EventCallback<ShoppingItemForm> OnAdd { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private async Task Submit()
    {
        await OnAdd.InvokeAsync(Model);
        Model = new ShoppingItemForm();
    }

    private async Task Cancel()
    {
        await OnCancel.InvokeAsync();
    }
}
