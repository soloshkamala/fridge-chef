@using Microsoft.Extensions.Localization
@inject IStringLocalizer<FridgeChef.ProfileResource> L
@using FridgeChef.Models

<MudPaper Class="pa-4" data-testid="header">


    <MudAvatar>
        @if (string.IsNullOrEmpty(User.AvatarUrl))
        {
            <MudIcon Icon="@Icons.Material.Outlined.Person" />
        }
        else
        {
            <img src="@User.AvatarUrl"
                 alt="@L["UserAvatar"]"
                 style="width:100%; height:100%; object-fit:cover;" />
        }
    </MudAvatar>


    <MudText Typo="Typo.h6">@User.Name</MudText>

    <MudChip T="string" Size="Size.Small">
        @User.Badge
    </MudChip>

    <MudText Typo="Typo.caption">@User.Email</MudText>

    @if (User.JoinedAt is { } d)
    {
        <MudText Typo="Typo.caption">
            @L["RegisteredOn"] @d.ToString("d MMMM yyyy")
        </MudText>
    }

    <MudText Typo="Typo.caption" data-testid="saved-count">
        @User.SavedCount @L["SavedRecipes"]
    </MudText>

    <MudText Typo="Typo.caption" data-testid="fav-count">
        @User.FavoriteCatalogs @L["FavoriteCatalogs"]
    </MudText>
</MudPaper>

@code {
    [Parameter, EditorRequired]
    public UserProfile User { get; set; } = default!;
}
