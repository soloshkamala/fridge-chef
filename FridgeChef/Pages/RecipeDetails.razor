@page "/recipes/{Id:int}"

@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using FridgeChef.Models
@using FridgeChef.Models.Recipes
@using FridgeChef.Services
@using FridgeChef.Resources

@attribute [Authorize]

@inject RecipesApiService RecipesApiService
@inject NavigationManager Navigation
@inject IStringLocalizer<RecipeDetailsResource> L

<PageTitle>@L["PageTitle"]</PageTitle>

<div class="recipe-details-page">

    @if (isLoading)
    {
        <MudProgressCircular Color="Color.Warning"
                             Indeterminate="true" />
        <MudText>@L["Loading"]</MudText>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <MudAlert Severity="Severity.Error">
            @errorMessage
        </MudAlert>
    }
    else if (recipe == null)
    {
        <MudText>@L["NotFound"]</MudText>
    }
    else
    {
        <MudButton Variant="Variant.Text"
                   OnClick="GoBack">
            ← @L["BackToFridge"]
        </MudButton>

        <div class="recipe-header">

            @if (!string.IsNullOrWhiteSpace(recipe.ImageUrl))
            {
                <img src="@recipe.ImageUrl"
                     alt="@recipe.Name"
                     class="recipe-photo" />
            }

            <div class="recipe-header-info">

                <h1>@recipe.Name</h1>

                @if (!string.IsNullOrWhiteSpace(recipe.CategoryName))
                {
                    <div class="recipe-category">
                        @recipe.CategoryName
                    </div>
                }

                <p>@recipe.Description</p>

                <div class="recipe-stats">
                    <span>⏱ @recipe.CookingTime @L["Minutes"]</span>
                    <span>🔥 @recipe.Calories @L["Calories"]</span>
                    <span>🍽 @recipe.Servings @L["Servings"]</span>
                </div>

                <div class="recipe-actions">

                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Warning"
                               StartIcon="@(isSaved ? Icons.Material.Filled.Bookmark : Icons.Material.Filled.BookmarkBorder)"
                               Disabled="@(isUpdating || !isCollectionLoaded)"
                               OnClick="ToggleSaved">
                        @(isSaved? L["Saved"] : L["SaveRecipe"])
                    </MudButton>

                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Error"
                               StartIcon="@(isFavorite ? Icons.Material.Filled.Favorite : Icons.Material.Filled.FavoriteBorder)"
                               Disabled="@(isUpdating || !isCollectionLoaded)"
                               OnClick="ToggleFavorite">
                        @(isFavorite? L["InFavorites"] : L["AddToFavorites"])
                    </MudButton>

                </div>

                @if (!string.IsNullOrEmpty(collectionError))
                {
                    <MudAlert Severity="Severity.Error"
                              Class="mt-3">
                        @collectionError
                    </MudAlert>
                }

            </div>
        </div>

        <div class="recipe-content">

            <section class="recipe-section">
                <h2>@L["Ingredients"]</h2>

                @if (recipe.Ingredients.Count == 0)
                {
                    <p>@L["NoIngredients"]</p>
                }
                else
                {
                    <ul class="ingredients-list">
                        @foreach (var ingredient in recipe.Ingredients)
                        {
                            <li>
                                <span>@ingredient.Name</span>
                                <span>
                                    @ingredient.Quantity
                                    @ingredient.Unit
                                </span>
                            </li>
                        }
                    </ul>
                }
            </section>

            <section class="recipe-section">
                <h2>@L["Instructions"]</h2>

                <p class="recipe-instructions">
                    @recipe.Instructions
                </p>
            </section>

        </div>
    }

</div>

<style>
    .recipe-details-page {
        max-width: 1100px;
        margin: 30px auto;
        padding: 24px;
    }

    .recipe-header {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 36px;
        margin-top: 24px;
        align-items: center;
    }

    .recipe-photo {
        width: 100%;
        height: 350px;
        object-fit: cover;
        border-radius: 18px;
    }

    .recipe-header-info h1 {
        font-size: 34px;
        font-weight: 700;
        margin-bottom: 16px;
    }

    .recipe-category {
        display: inline-block;
        padding: 8px 16px;
        border-radius: 20px;
        background-color: #fff0e6;
        color: #FA641E;
        font-weight: 600;
        margin-bottom: 16px;
    }

    .recipe-header-info p {
        color: #666;
        line-height: 1.7;
    }

    .recipe-stats {
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
        margin-top: 24px;
    }

        .recipe-stats span {
            padding: 10px 16px;
            border-radius: 12px;
            background-color: #f6f6f6;
            font-weight: 500;
        }

    .recipe-actions {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 24px;
    }

    .recipe-content {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 36px;
        margin-top: 40px;
    }

    .recipe-section {
        padding: 28px;
        border: 1px solid #eee8e2;
        border-radius: 18px;
        background-color: white;
    }

        .recipe-section h2 {
            font-size: 24px;
            font-weight: 700;
            margin-bottom: 24px;
        }

    .ingredients-list {
        list-style: none;
        padding: 0;
    }

        .ingredients-list li {
            display: flex;
            justify-content: space-between;
            gap: 16px;
            padding: 14px 0;
            border-bottom: 1px solid #eee;
        }

    .recipe-instructions {
        line-height: 1.9;
        white-space: pre-line;
    }

    @@media (max-width: 768px) {
        .recipe-header,
        .recipe-content {
            grid-template-columns: 1fr;
        }

        .recipe-photo {
            height: 250px;
        }
    }
</style>

@code {
    [Parameter]
    public int Id { get; set; }

    private RecipeResponse? recipe;
    private bool isLoading = true;
    private bool isSaved;
    private bool isFavorite;
    private bool isUpdating;
    private bool isCollectionLoaded;
    private string? errorMessage;
    private string? collectionError;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        isSaved = false;
        isFavorite = false;
        isUpdating = false;
        isCollectionLoaded = false;
        errorMessage = null;
        collectionError = null;
        recipe = null;

        try
        {
            recipe = await RecipesApiService.GetRecipeByIdAsync(Id);

            if (recipe != null)
            {
                try
                {
                    var collection =
                        await RecipesApiService.GetRecipeCollectionAsync(Id);

                    isSaved = collection.IsSaved;
                    isFavorite = collection.IsFavorite;
                    isCollectionLoaded = true;
                }
                catch (Exception)
                {
                    collectionError = L["CollectionLoadingError"];
                }
            }
        }
        catch (Exception)
        {
            errorMessage = L["LoadingError"];
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ToggleSaved()
    {
        if (isUpdating || !isCollectionLoaded)
            return;

        isUpdating = true;
        collectionError = null;

        try
        {
            var newValue = !isSaved;

            await RecipesApiService.SetRecipeSavedAsync(Id, newValue);

            isSaved = newValue;
        }
        catch (Exception)
        {
            collectionError = L["SaveError"];
        }
        finally
        {
            isUpdating = false;
        }
    }

    private async Task ToggleFavorite()
    {
        if (isUpdating || !isCollectionLoaded)
            return;

        isUpdating = true;
        collectionError = null;

        try
        {
            var newValue = !isFavorite;

            await RecipesApiService.SetRecipeFavoriteAsync(Id, newValue);

            isFavorite = newValue;
        }
        catch (Exception)
        {
            collectionError = L["FavoriteError"];
        }
        finally
        {
            isUpdating = false;
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/fridge");
    }
}