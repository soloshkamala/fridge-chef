
@page "/login"

@using FridgeChef.Components
@using FridgeChef.Models
@using FridgeChef.Services

@inject AuthStateService AuthState
@inject AuthService AuthService
@inject NavigationManager Navigation

<div class="login-page">
    <div class="login-content">

        <!-- Ліва частина -->
        <section class="login-left">

            <h1>
                Готуй смачно з того,<br />
                що є в холодильнику!
            </h1>

            <p class="login-description">
                FridgeChef допоможе тобі створити смачні,
                корисні та прості рецепти з наявних у тебе
                продуктів. Більше жодних роздумів над вечерею.
            </p>

            <img src="images/login-illustration.png"
                 alt="Переваги FridgeChef та корисні страви"
                 class="login-illustration" />

        </section>

        <!-- Права частина -->
        <section class="login-right">

            <div class="login-card">

                <div class="login-tabs">
                    <span class="active-tab">Вхід</span>
                    <span>Реєстрація</span>
                </div>

                <h2>Ласкаво просимо!</h2>

                <p class="login-subtitle">
                    Увійдіть у свій обліковий запис,
                    щоб продовжити.
                </p>

                @if (AuthState.IsLoading)
                {
                    <p>Виконується вхід...</p>
                }
                else
                {
                    @if (!string.IsNullOrEmpty(AuthState.ErrorMessage))
                    {
                        <div class="login-error" role="alert">
                            @AuthState.ErrorMessage
                        </div>
                    }

                    <LoginForm OnLogin="HandleLogin" />
                }

            </div>

        </section>
    </div>

    <footer class="login-footer">
        <strong>FridgeChef</strong>
        <p>
            © 2026 FridgeChef.
            Смачні рецепти ближче, ніж здається.
        </p>
    </footer>
</div>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private async Task HandleLogin(LoginModel model)
{
    AuthState.SetLoading();

    try
    {
        if (await AuthService.LoginAsync(model.Email, model.Password))
        {
            await AuthState.SaveLoginAsync(model.Email);
            Navigation.NavigateTo(GetSafeReturnUrl());
        }
        else
        {
            AuthState.SetError("Неправильний Email або пароль");
        }
    }
    catch (HttpRequestException)
    {
        AuthState.SetError("Не вдалося підключитися до сервера");
    }
}

    private string GetSafeReturnUrl()
    {
        if (!string.IsNullOrWhiteSpace(ReturnUrl)
            && ReturnUrl.StartsWith("/")
            && !ReturnUrl.StartsWith("//")
            && !ReturnUrl.StartsWith("/\\")
            && !ReturnUrl.Contains('\\')
            && !ReturnUrl.Any(char.IsControl))
        {
            return ReturnUrl;
        }

        return "/profile";
    }
}
