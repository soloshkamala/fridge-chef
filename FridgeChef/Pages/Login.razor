
@page "/login"
@using FridgeChef.Components
@using FridgeChef.Services
@implements IDisposable
@inject AuthStateService AuthState

<PageTitle>FridgeChef - Вхід</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">

    <MudText Typo="Typo.h4">
        Ласкаво просимо
    </MudText>

    @if (AuthState.IsLoading)
    {
        <MudProgressCircular
            Color="Color.Primary"
            Indeterminate="true" />

        <MudText>Завантаження...</MudText>
    }
    else if (!string.IsNullOrEmpty(AuthState.UserEmail))
    {
        <MudAlert Severity="Severity.Success" Class="mt-4">
            Вхід виконано успішно
        </MudAlert>

        <MudText Class="mt-4">
            Email: @AuthState.UserEmail
        </MudText>
    }
    else
    {
        @if (!string.IsNullOrEmpty(AuthState.ErrorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mt-4 mb-4">
                @AuthState.ErrorMessage
            </MudAlert>
        }

        <LoginForm />
    }

</MudContainer>

@code {
    protected override void OnInitialized()
    {
        AuthState.OnChange += RefreshPage;
    }

    private void RefreshPage()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        AuthState.OnChange -= RefreshPage;
    }
}
