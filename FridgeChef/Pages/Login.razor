@page "/login"

@using System.Net
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.WebAssembly.Http
@using FridgeChef.Services

@inject HttpClient Http
@inject AuthService AuthService
@inject AuthStateService AuthState
@inject NavigationManager Navigation

<PageTitle>Вхід та реєстрація — FridgeChef</PageTitle>

<div class="container mt-4" style="max-width: 450px;">
    <a class="btn btn-primary w-100"
       href="/authentication/login">
        Увійти через Microsoft
    </a>
</div>
<div class="container mt-5" style="max-width: 450px;">
    <h2 class="text-center mb-4">FridgeChef</h2>

    <div class="d-flex justify-content-center gap-3 mb-4">
        <button class="btn @(!_isRegistering ? "btn-primary" : "btn-outline-primary")"
                @onclick="() => SwitchMode(false)">
            Вхід
        </button>

        <button class="btn @(_isRegistering ? "btn-primary" : "btn-outline-primary")"
                @onclick="() => SwitchMode(true)">
            Реєстрація
        </button>
    </div>

    @if (!_isRegistering)
    {
        <h4 class="text-center mb-3">Вхід до акаунта</h4>

        <div class="mb-3">
            <label class="form-label">Email</label>
            <input class="form-control"
                   type="email"
                   @bind="_email"
                   placeholder="Введіть Email" />
        </div>

        <div class="mb-3">
            <label class="form-label">Пароль</label>
            <input class="form-control"
                   type="password"
                   @bind="_password"
                   placeholder="Введіть пароль" />
        </div>

        @if (!string.IsNullOrWhiteSpace(_loginError))
        {
            <div class="alert alert-danger">
                @_loginError
            </div>
        }

        <button class="btn btn-primary w-100"
                @onclick="HandleLogin"
                disabled="@_processing">
            @(_processing ? "Виконується..." : "Увійти")
        </button>
    }
    else
    {
        <h4 class="text-center mb-3">Створення акаунта</h4>

        <div class="mb-3">
            <label class="form-label">Ім'я</label>
            <input class="form-control"
                   @bind="_registerModel.DisplayName"
                   placeholder="Введіть ім'я" />
        </div>

        <div class="mb-3">
            <label class="form-label">Email</label>
            <input class="form-control"
                   type="email"
                   @bind="_registerModel.Email"
                   placeholder="Введіть Email" />
        </div>

        <div class="mb-3">
            <label class="form-label">Пароль</label>
            <input class="form-control"
                   type="password"
                   @bind="_registerModel.Password"
                   placeholder="Створіть пароль" />
        </div>

        @if (!string.IsNullOrWhiteSpace(_registerError))
        {
            <div class="alert alert-danger">
                @_registerError
            </div>
        }

        <button class="btn btn-primary w-100"
                @onclick="HandleRegister"
                disabled="@_processing">
            @(_processing ? "Виконується..." : "Зареєструватися")
        </button>
    }
</div>

@code {
    private bool _isRegistering;
    private bool _processing;

    private string _email = "";
    private string _password = "";

    private string? _loginError;
    private string? _registerError;

    private RegisterModel _registerModel = new();

    private void SwitchMode(bool registering)
    {
        _isRegistering = registering;
        _loginError = null;
        _registerError = null;
    }

    private async Task HandleLogin()
    {
        _processing = true;
        _loginError = null;

        try
        {
            if (string.IsNullOrWhiteSpace(_email) ||
                string.IsNullOrWhiteSpace(_password))
            {
                _loginError = "Заповніть Email та пароль.";
                return;
            }

            bool success = await AuthService.LoginAsync(
                _email.Trim(),
                _password);

            if (success)
            {
                await AuthState.SaveLoginAsync(_email.Trim());
                Navigation.NavigateTo("/profile");
            }
            else
            {
                _loginError = "Неправильний Email або пароль.";
            }
        }
        catch (Exception ex)
        {
            _loginError = $"Помилка входу: {ex.Message}";
        }
        finally
        {
            _processing = false;
        }
    }

    private async Task HandleRegister()
    {
        _processing = true;
        _registerError = null;

        try
        {
            if (string.IsNullOrWhiteSpace(_registerModel.DisplayName) ||
                string.IsNullOrWhiteSpace(_registerModel.Email) ||
                string.IsNullOrWhiteSpace(_registerModel.Password))
            {
                _registerError = "Заповніть усі поля.";
                return;
            }

            var request = new HttpRequestMessage(
                HttpMethod.Post,
                "https://localhost:7173/api/users")
            {
                Content = JsonContent.Create(new
                {
                    email = _registerModel.Email.Trim(),
                    password = _registerModel.Password,
                    displayName = _registerModel.DisplayName.Trim()
                })
            };

            request.SetBrowserRequestCredentials(
                BrowserRequestCredentials.Include);

            using var response = await Http.SendAsync(request);

            if (response.IsSuccessStatusCode)
            {
                await AuthState.SaveLoginAsync(
                    _registerModel.Email.Trim());

                Navigation.NavigateTo("/profile");
                return;
            }

            var error = await response.Content.ReadAsStringAsync();

            if (response.StatusCode == HttpStatusCode.Conflict)
            {
                _registerError =
                    "Користувач із таким Email вже існує. Спробуйте увійти.";
            }
            else
            {
                _registerError =
                    $"Помилка реєстрації. HTTP {(int)response.StatusCode}. Деталі: {error}";
            }
        }
        catch (HttpRequestException ex)
        {
            _registerError =
                $"Не вдалося підключитися до сервера: {ex.Message}";
        }
        catch (Exception ex)
        {
            _registerError = $"Помилка: {ex.Message}";
        }
        finally
        {
            _processing = false;
        }
    }

    private class RegisterModel
    {
        public string DisplayName { get; set; } = "";
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
    }
}
