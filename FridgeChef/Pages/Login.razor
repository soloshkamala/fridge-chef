@inject Microsoft.Extensions.Localization.IStringLocalizer<FridgeChef.Resources.LoginResource> L
@page "/login"

@using System.Net
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.WebAssembly.Http
@using FridgeChef.Services

@inject HttpClient Http
@inject AuthService AuthService
@inject AuthStateService AuthState
@inject NavigationManager Navigation

<PageTitle>Вхід та реєстрація — FridgeChef</PageTitle>

<div class="login-page">
    <div class="login-content">

        <section class="login-left">
            <p class="login-eyebrow">@L["HeroEyebrow"]</p>
            <h1>@L["HeroTitle"]</h1>
            <p class="login-description">
                Discover delicious recipes, organize your ingredients,
                and make everyday cooking easier with FridgeChef.
            </p>

            <div class="login-feature">
                <span>✦</span>
                @L["HeroFeature"]
            </div>
        </section>

        <section class="login-right">
            <div class="login-card">

                <div class="login-brand">Fridge<span>Chef.</span></div>

                <h2>@L["WelcomeTitle"]</h2>
                <p class="login-subtitle">
                    @L["WelcomeSubtitle"]
                </p>

                <a class="btn microsoft-login w-100"
                   href="/authentication/login">
                    <span class="microsoft-icon">▦</span>
                    @L["MicrosoftLogin"]
                </a>

                <div class="login-divider">
                    <span>@L["EmailDivider"]</span>
                </div>

                <div class="login-tabs">
                    <button type="button"
                            class="@(!_isRegistering ? "active-tab" : "")"
                            @onclick="() => SwitchMode(false)">
                        @L["SignIn"]
                    </button>

                    <button type="button"
                            class="@(_isRegistering ? "active-tab" : "")"
                            @onclick="() => SwitchMode(true)">
                        @L["SignUp"]
                    </button>
                </div>

                @if (!_isRegistering)
                {
                    <div class="mb-3">
                        <label class="form-label">@L["EmailAddress"]</label>
                        <input class="form-control"
                               type="email"
                               @bind="_email"
                               placeholder="@L["EmailPlaceholder"]" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">@L["Password"]</label>
                        <input class="form-control"
                               type="password"
                               @bind="_password"
                               placeholder="@L["PasswordPlaceholder"]" />
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_loginError))
                    {
                        <div class="alert alert-danger">@_loginError</div>
                    }

                    <button class="btn btn-primary w-100"
                            @onclick="HandleLogin"
                            disabled="@_processing">
                        @(_processing ? L["SigningIn"] : L["SignIn"])
                    </button>
                }
                else
                {
                    <div class="mb-3">
                        <label class="form-label">@L["Name"]</label>
                        <input class="form-control"
                               @bind="_registerModel.DisplayName"
                               placeholder="@L["NamePlaceholder"]" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">@L["EmailAddress"]</label>
                        <input class="form-control"
                               type="email"
                               @bind="_registerModel.Email"
                               placeholder="@L["EmailPlaceholder"]" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">@L["Password"]</label>
                        <input class="form-control"
                               type="password"
                               @bind="_registerModel.Password"
                               placeholder="@L["CreatePassword"]" />
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_registerError))
                    {
                        <div class="alert alert-danger">@_registerError</div>
                    }

                    <button class="btn btn-primary w-100"
                            @onclick="HandleRegister"
                            disabled="@_processing">
                        @(_processing ? L["CreatingAccount"] : L["CreateAccount"])
                    </button>
                }

                <p class="login-bottom-text">
                    @L["BottomText"]
                </p>
            </div>
        </section>
    </div>
</div>
@code {
    private bool _isRegistering;
    private bool _processing;

    private string _email = "";
    private string _password = "";

    private string? _loginError;
    private string? _registerError;

    private RegisterModel _registerModel = new();

    private void SwitchMode(bool registering)
    {
        _isRegistering = registering;
        _loginError = null;
        _registerError = null;
    }

    private async Task HandleLogin()
    {
        _processing = true;
        _loginError = null;

        try
        {
            if (string.IsNullOrWhiteSpace(_email) ||
                string.IsNullOrWhiteSpace(_password))
            {
                _loginError = "Заповніть Email та пароль.";
                return;
            }

            bool success = await AuthService.LoginAsync(
                _email.Trim(),
                _password);

            if (success)
            {
                await AuthState.SaveLoginAsync(_email.Trim());
                Navigation.NavigateTo("/profile");
            }
            else
            {
                _loginError = "Неправильний Email або пароль.";
            }
        }
        catch (Exception ex)
        {
            _loginError = $"Помилка входу: {ex.Message}";
        }
        finally
        {
            _processing = false;
        }
    }

    private async Task HandleRegister()
    {
        _processing = true;
        _registerError = null;

        try
        {
            if (string.IsNullOrWhiteSpace(_registerModel.DisplayName) ||
                string.IsNullOrWhiteSpace(_registerModel.Email) ||
                string.IsNullOrWhiteSpace(_registerModel.Password))
            {
                _registerError = "Заповніть усі поля.";
                return;
            }

            var request = new HttpRequestMessage(
                HttpMethod.Post,
                "https://localhost:7173/api/users")
            {
                Content = JsonContent.Create(new
                {
                    email = _registerModel.Email.Trim(),
                    password = _registerModel.Password,
                    displayName = _registerModel.DisplayName.Trim()
                })
            };

            request.SetBrowserRequestCredentials(
                BrowserRequestCredentials.Include);

            using var response = await Http.SendAsync(request);

            if (response.IsSuccessStatusCode)
            {
                await AuthState.SaveLoginAsync(
                    _registerModel.Email.Trim());

                Navigation.NavigateTo("/profile");
                return;
            }

            var error = await response.Content.ReadAsStringAsync();

            if (response.StatusCode == HttpStatusCode.Conflict)
            {
                _registerError =
                    "Користувач із таким Email вже існує. Спробуйте увійти.";
            }
            else
            {
                _registerError =
                    $"Помилка реєстрації. HTTP {(int)response.StatusCode}. Деталі: {error}";
            }
        }
        catch (HttpRequestException ex)
        {
            _registerError =
                $"Не вдалося підключитися до сервера: {ex.Message}";
        }
        catch (Exception ex)
        {
            _registerError = $"Помилка: {ex.Message}";
        }
        finally
        {
            _processing = false;
        }
    }

    private class RegisterModel
    {
        public string DisplayName { get; set; } = "";
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
    }
}
