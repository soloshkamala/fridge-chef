@page "/fridge"

@using FridgeChef.Models
@using FridgeChef.Components
@using FridgeChef.Services
@using Microsoft.Extensions.Localization
@using Microsoft.JSInterop

@inject IJSRuntime JS
@inject IStringLocalizer<FridgeChef.Resources.SharedResource> Localizer
@inject FridgeService FridgeService
@inject IDialogService DialogService

<PageTitle>@Localizer["PageTitle"]</PageTitle>

<MudButton OnClick='() => ChangeLanguage("uk-UA")'>
    UA
</MudButton>

<MudButton OnClick='() => ChangeLanguage("en-US")'>
    EN
</MudButton>

<h1>
    @Localizer["HeroTitleFirst"]<br />
    @Localizer["HeroTitleSecond"]
</h1>

<p>
    @Localizer["HeroDescription"]
</p>

<h3>@Localizer["FridgeTitle"]</h3>

<MudTextField T="string"
              @bind-Value="searchText"
              Placeholder="@Localizer["SearchPlaceholder"]"
              Immediate="true"
              Variant="Variant.Outlined" />

@if (!string.IsNullOrWhiteSpace(searchText))
{
    @if (!FilteredIngredients.Any())
    {
        <MudText Color="Color.Secondary" Class="mt-2">
            @Localizer["NoProductsFound"]
        </MudText>
    }
    else
    {
        <div>
            @foreach (var ingredient in FilteredIngredients)
            {
                <MudPaper @key="ingredient.Id"
                          Class="pa-3 mt-2"
                          Style="cursor: pointer;"
                          @onclick="() => OpenIngredientDialog(ingredient)">
                    @Localizer[$"Ingredient{ingredient.Id}"]
                </MudPaper>
            }
        </div>
    }
}

@if (FridgeService.IsLoading)
{
    <p>@Localizer["Loading"]</p>
}
else if (!string.IsNullOrWhiteSpace(FridgeService.ErrorMessage))
{
    <p>@FridgeService.ErrorMessage</p>
}
else if (FridgeService.FridgeItems.Count > 0)
{
    <h3>@Localizer["FridgeItemsTitle"]</h3>

    <div>
        @foreach (var item in FridgeService.FridgeItems)
        {
            <IngredientCard @key="item.Id"
                            Item="item" />
        }
    </div>

    <h3>@Localizer["RecipesTitle"]</h3>
}
else
{
    <p>@Localizer["EmptyFridge"]</p>
}

@code {

    private async Task ChangeLanguage(string culture)
    {
        await JS.InvokeVoidAsync("fridgeCulture.set", culture);
        await JS.InvokeVoidAsync("location.reload");
    }
    private string searchText = "";

    private IEnumerable<Ingredient> FilteredIngredients =>
     FridgeService.Ingredients
         .Where(x =>
             Localizer[$"Ingredient{x.Id}"].Value.Contains(
                 searchText,
                 StringComparison.CurrentCultureIgnoreCase));

    private async Task OpenIngredientDialog(Ingredient ingredient)
    {
        var parameters = new DialogParameters<AddIngredientDialog>
        {
            { x => x.Ingredient, ingredient }
        };

        var dialog = await DialogService.ShowAsync<AddIngredientDialog>(
            Localizer["AddProductTitle"].Value,
            parameters);

        var result = await dialog.Result;

        if (result != null &&
            !result.Canceled &&
            result.Data is FridgeItem item)
        {
            FridgeService.AddToFridge(
                item.Ingredient,
                item.Quantity,
                item.Unit);

            searchText = "";
        }
    }
}
