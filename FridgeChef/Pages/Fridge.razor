@page "/fridge"

@using FridgeChef.Models
@using FridgeChef.Models.Recipes
@using FridgeChef.Components
@using FridgeChef.Services
@using Microsoft.Extensions.Localization

@inject IStringLocalizer<FridgeChef.Resources.SharedResource> Localizer
@inject FridgeService FridgeService
@inject FridgeItemsApiService ApiService
@inject RecipesApiService RecipesApiService
@inject IDialogService DialogService

<PageTitle>@Localizer["PageTitle"]</PageTitle>

<div class="fridge-page">

    <section class="hero">
        <div class="hero-content">

            <h1>
                @Localizer["HeroTitleFirst"]
                <br />
                <span>@Localizer["HeroTitleSecond"]</span>
            </h1>

            <p class="hero-description">
                @Localizer["HeroDescription"]
            </p>
        </div>

        <div class="hero-image">
            <img src="fridge-hero.png"
                 alt="Fresh ingredients and food" />
        </div>
    </section>

    <section class="fridge-section">

        <div class="section-heading">
            <h2>@Localizer["FridgeTitle"]</h2>
        </div>

        <div class="search-container">
            <MudTextField T="string"
                          @bind-Value="searchText"
                          Placeholder="@Localizer["SearchPlaceholder"]"
                          Immediate="true"
                          Variant="Variant.Outlined"
                          Class="ingredient-search" />

            @if (!string.IsNullOrWhiteSpace(searchText) && !isDialogOpen)
            {
                <div class="search-results">

                    @if (!FilteredIngredients.Any())
                    {
                        <div class="search-empty">
                            @Localizer["NoProductsFound"]
                        </div>
                    }
                    else
                    {
                        @foreach (var ingredient in FilteredIngredients)
                        {
                            <MudPaper @key="ingredient.Id"
                                      Class="search-result-item"
                                      Elevation="0"
                                      @onclick="() => OpenIngredientDialog(ingredient)">
                                <span>
                                    @Localizer[$"Ingredient{ingredient.Id}"]
                                </span>
                                <span class="add-symbol">+</span>
                            </MudPaper>
                        }
                    }
                </div>
            }
        </div>

        @if (FridgeService.IsLoading)
        {
            <div class="status-card">
                <MudProgressCircular Indeterminate="true"
                                     Color="Color.Warning"
                                     Size="Size.Medium" />
                <p>@Localizer["Loading"]</p>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(FridgeService.ErrorMessage))
        {
            <div class="status-card error-card">
                <p>@FridgeService.ErrorMessage</p>
            </div>
        }
        else if (FridgeService.FridgeItems.Count > 0)
        {
            <div class="fridge-content">

                <h3>@Localizer["FridgeItemsTitle"]</h3>

                <div class="ingredients-grid">
                    @foreach (var item in FridgeService.FridgeItems)
                    {
                        <div class="ingredient-wrapper" @key="item.Id">
                            <IngredientCard Item="item" />
                        </div>
                    }
                </div>

                <div class="recipes-section">
                    <h2>@Localizer["RecipesTitle"]</h2>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Warning"
                               Disabled="@isSearchingRecipes"
                               OnClick="SearchRecipesAsync">

                        @if (isSearchingRecipes)
                        {
                            <MudProgressCircular Indeterminate="true"
                                                 Size="Size.Small"
                                                 Class="mr-2" />
                            <span>Шукаємо рецепти...</span>
                        }
                        else
                        {
                            <span>Знайти рецепти</span>
                        }

                    </MudButton>

                    @if (!string.IsNullOrWhiteSpace(recipesError))
                    {
                        <div class="status-card error-card">
                            @recipesError
                        </div>
                    }
                    else if (hasSearchedRecipes && !isSearchingRecipes)
                    {
                        @if (recommendedRecipes.Count == 0)
                        {
                            <p>За наявними продуктами рецептів поки не знайдено.</p>
                        }
                        else
                        {
                            <div class="recipes-grid">

                                @foreach (var recommendation in recommendedRecipes)
                                {
                                    <MudPaper @key="recommendation.Recipe.Id"
                                              Class="recipe-card"
                                              Elevation="2">

                                        @if (!string.IsNullOrWhiteSpace(recommendation.Recipe.ImageUrl))
                                        {
                                            <img src="@recommendation.Recipe.ImageUrl"
                                                 alt="@recommendation.Recipe.Name"
                                                 class="recipe-image" />
                                        }

                                        <div class="recipe-card-content">

                                            <h3>@recommendation.Recipe.Name</h3>

                                            <p>@recommendation.Recipe.Description</p>

                                            <p>
                                                Час приготування:
                                                @recommendation.Recipe.CookingTime хв.
                                            </p>

                                            <p>
                                                Калорійність:
                                                @recommendation.Recipe.Calories ккал
                                            </p>

                                            <p>
                                                Відповідність:
                                                @recommendation.MatchPercentage%
                                            </p>

                                            <p>
                                                <strong>Є в холодильнику:</strong>
                                                @string.Join(", ", recommendation.AvailableIngredients)
                                            </p>

                                            @if (recommendation.MissingIngredients.Count > 0)
                                            {
                                                <p>
                                                    <strong>Не вистачає:</strong>
                                                    @string.Join(", ", recommendation.MissingIngredients)
                                                </p>
                                            }

                                        </div>
                                    </MudPaper>
                                }

                            </div>
                        }
                    }
                </div>

            </div>
        }
        else
        {
            <div class="empty-fridge">
                <div class="empty-icon">
                    <MudIcon Icon="@Icons.Material.Filled.Kitchen"
                             Size="Size.Large" />
                </div>

                <p>@Localizer["EmptyFridge"]</p>
            </div>
        }

    </section>
</div>

@code {
    private string searchText = "";

    private bool isDialogOpen = false;

    private List<RecommendedRecipeResponse> recommendedRecipes = new();

    private bool isSearchingRecipes = false;

    private bool hasSearchedRecipes = false;

    private string? recipesError;

    protected override async Task OnInitializedAsync()
    {
        FridgeService.IsLoading = true;
        FridgeService.ErrorMessage = null;

        try
        {
            var items = await ApiService.GetItemsAsync();

            FridgeService.FridgeItems.Clear();
            FridgeService.FridgeItems.AddRange(items);
        }
        catch
        {
            FridgeService.ErrorMessage = Localizer["LoadingError"].Value;
        }
        finally
        {
            FridgeService.IsLoading = false;
        }
    }

    private IEnumerable<Ingredient> FilteredIngredients =>
        FridgeService.Ingredients
            .Where(x =>
                Localizer[$"Ingredient{x.Id}"].Value.Contains(
                    searchText,
                    StringComparison.CurrentCultureIgnoreCase));

    private async Task OpenIngredientDialog(Ingredient ingredient)
    {
        isDialogOpen = true;

        try
        {
            var parameters = new DialogParameters<AddIngredientDialog>
            {
                { x => x.Ingredient, ingredient }
            };

            var dialog = await DialogService.ShowAsync<AddIngredientDialog>(
                Localizer["AddProductTitle"].Value,
                parameters);

            var result = await dialog.Result;

            if (result != null && !result.Canceled && result.Data is FridgeItem item)
            {
                try
                {
                    var savedItem = await ApiService.AddItemAsync(item);

                    FridgeService.FridgeItems.Add(savedItem);
                    searchText = "";

                    recommendedRecipes.Clear();
                    hasSearchedRecipes = false;
                }
                catch
                {
                    FridgeService.ErrorMessage = "Не вдалося додати продукт на сервер.";
                }
            }
        }
        finally
        {
            isDialogOpen = false;
        }
    }

    private async Task SearchRecipesAsync()
    {
        isSearchingRecipes = true;
        hasSearchedRecipes = false;
        recipesError = null;

        try
        {
            recommendedRecipes = await RecipesApiService.GetRecommendedRecipesAsync();
            hasSearchedRecipes = true;
        }
        catch
        {
            recipesError = "Не вдалося завантажити рецепти. Спробуйте ще раз.";
        }
        finally
        {
            isSearchingRecipes = false;
        }
    }
}
