@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@page "/fridge"

@implements IAsyncDisposable

@using FridgeChef.Models
@using FridgeChef.Models.Recipes
@using FridgeChef.Components
@using FridgeChef.Services
@using Microsoft.Extensions.Localization

@inject IStringLocalizer<FridgeChef.Resources.SharedResource> Localizer
@inject FridgeService FridgeService
@inject FridgeSignalRService SignalRService
@inject FridgeItemsApiService ApiService
@inject ProductsApiService ProductsApiService
@inject RecipesApiService RecipesApiService
@inject IDialogService DialogService
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>@Localizer["PageTitle"]</PageTitle>

<div class="fridge-page">

    <section class="hero">
        <div class="hero-content">
            <h1>
                @Localizer["HeroTitleFirst"]
                <br />
                <span>@Localizer["HeroTitleSecond"]</span>
            </h1>

            <p class="hero-description">
                @Localizer["HeroDescription"]
            </p>
        </div>

        <div class="hero-image">
            <img src="fridge-hero.png"
                 alt="Fresh ingredients and food" />
        </div>
    </section>

    <section class="fridge-section">

        <div class="section-heading">
            <h2>@Localizer["FridgeTitle"]</h2>
        </div>

        <div class="search-container">
            <MudTextField T="string"
                          @bind-Value="searchText"
                          Placeholder="@Localizer["SearchPlaceholder"]"
                          Immediate="true"
                          Variant="Variant.Outlined"
                          Class="ingredient-search" />

            @if (!string.IsNullOrWhiteSpace(searchText) && !isDialogOpen)
            {
                <div class="search-results">

                    @if (!FilteredIngredients.Any())
                    {
                        <div class="search-empty">
                            @Localizer["NoProductsFound"]
                        </div>
                    }
                    else
                    {
                        @foreach (var ingredient in FilteredIngredients)
                        {
                            <MudPaper @key="ingredient.Id"
                                      Class="search-result-item"
                                      Elevation="0"
                                      @onclick="() => OpenIngredientDialog(ingredient)">
                                <span>@ingredient.Name</span>
                                <span class="add-symbol">+</span>
                            </MudPaper>
                        }
                    }

                </div>
            }
        </div>

        @if (FridgeService.IsLoading)
        {
            <div class="status-card">
                <MudProgressCircular Indeterminate="true"
                                     Color="Color.Warning"
                                     Size="Size.Medium" />
                <p>@Localizer["Loading"]</p>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(FridgeService.ErrorMessage))
        {
            <div class="status-card error-card">
                <p>@FridgeService.ErrorMessage</p>
            </div>
        }
        else if (FridgeService.FridgeItems.Count > 0)
        {
            <div class="fridge-content">

                <h3>@Localizer["FridgeItemsTitle"]</h3>

                <div class="ingredients-grid">
                    @foreach (var item in FridgeService.FridgeItems)
                    {
                        <div class="ingredient-wrapper" @key="item.Id">
                            <IngredientCard Item="item"
                                            OnEdit="EditIngredientAsync"
                                            OnDelete="DeleteIngredientAsync" />
                        </div>
                    }
                </div>

                <div class="recipes-section">
                    <h2>@Localizer["RecipesTitle"]</h2>

                    <MudButton Variant="Variant.Filled"
                               Style="background-color: #FA641E;
                                          color: white;
                                          border-radius: 30px;
                                          padding: 10px 24px;"
                               Disabled="@isSearchingRecipes"
                               OnClick="SearchRecipesAsync">

                        @if (isSearchingRecipes)
                        {
                            <MudProgressCircular Indeterminate="true"
                                                 Size="Size.Small"
                                                 Class="mr-2" />
                            <span>@Localizer["SearchingRecipes"]</span>
                        }
                        else
                        {
                            <span>@Localizer["FindRecipes"]</span>
                        }

                    </MudButton>

                    @if (!string.IsNullOrWhiteSpace(recipesError))
                    {
                        <div class="status-card error-card">
                            @recipesError
                        </div>
                    }
                    else if (hasSearchedRecipes && !isSearchingRecipes)
                    {
                        @if (recommendedRecipes.Count == 0)
                        {
                            <p>@Localizer["NoRecommendedRecipes"]</p>
                        }
                        else
                        {
                            <div class="recipes-grid"
                                 style="display:grid;grid-template-columns:repeat(auto-fill, 220px);gap:24px;margin-top:24px;justify-content:start;">

                                @foreach (var recommendation in recommendedRecipes)
                                {
                                    <div @key="recommendation.Recipe.Id"
                                         role="link"
                                         tabindex="0"
                                         style="cursor:pointer;"
                                         @onclick="() => OpenRecipe(recommendation.Recipe.Id)"
                                         @onkeydown="e => HandleRecipeKeyDown(e, recommendation.Recipe.Id)">

                                        <RecipeCard UseDatabaseTitle="true"
                                                    Recipe="@(new RecipeSummary(
                                                                                                            recommendation.Recipe.Id.ToString(),
                                                                                                            recommendation.Recipe.Name,
                                                                                                            recommendation.Recipe.ImageUrl,
                                                                                                            recommendation.Recipe.CookingTime,
                                                                                                            recommendation.Recipe.Calories
                                                                                                        ))" />
                    </div>
                                        }
                            </div>
                        }
                    }
                </div>

            </div>
        }
        else
        {
            <div class="empty-fridge">
                <div class="empty-icon">
                    <MudIcon Icon="@Icons.Material.Filled.Kitchen"
                             Size="Size.Large" />
                </div>

                <p>@Localizer["EmptyFridge"]</p>
            </div>
        }

    </section>
</div>

@code {
    private string searchText = "";

    private bool isDialogOpen = false;

    private List<RecommendedRecipeResponse> recommendedRecipes = new();

    private bool isSearchingRecipes = false;

    private bool hasSearchedRecipes = false;

    private string? recipesError;

    private bool isDisposed = false;

    protected override async Task OnInitializedAsync()
    {
        FridgeService.IsLoading = true;
        FridgeService.ErrorMessage = null;

        try
        {
            var profileResponse = await Http.GetAsync("api/profiles/me");
            profileResponse.EnsureSuccessStatusCode();

            var products = await ProductsApiService.GetProductsAsync();
            FridgeService.SetIngredients(products);

            var items = await ApiService.GetItemsAsync();

            FridgeService.FridgeItems.Clear();
            FridgeService.FridgeItems.AddRange(items);

            SignalRService.FridgeChanged += OnFridgeChangedAsync;

            await SignalRService.StartAsync();

            await SyncItemSubscriptionsAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Fridge loading error: {ex}");
            FridgeService.ErrorMessage = Localizer["LoadingError"].Value;
        }
        finally
        {
            FridgeService.IsLoading = false;
        }
    }

    private async Task SyncItemSubscriptionsAsync()
    {
        if (isDisposed)
            return;

        var itemIds = FridgeService.FridgeItems
            .Select(x => x.Id)
            .ToArray();

        await SignalRService.SubscribeToItemsAsync(itemIds);
    }

    private IEnumerable<Ingredient> FilteredIngredients =>
        FridgeService.Ingredients
            .Where(x => x.Name.Contains(
                searchText,
                StringComparison.CurrentCultureIgnoreCase));

    private async Task OpenIngredientDialog(Ingredient ingredient)
    {
        isDialogOpen = true;

        try
        {
            var parameters = new DialogParameters<AddIngredientDialog>
            {
                { x => x.Ingredient, ingredient }
            };

            var dialog = await DialogService.ShowAsync<AddIngredientDialog>(
                Localizer["AddProductTitle"].Value,
                parameters);

            var result = await dialog.Result;

            if (result != null &&
                !result.Canceled &&
                result.Data is FridgeItem item)
            {
                try
                {
                    var savedItem = await ApiService.AddItemAsync(item);

                    var existingItem = FridgeService.FridgeItems
                        .FirstOrDefault(x => x.Id == savedItem.Id);

                    if (existingItem != null)
                    {
                        var index = FridgeService.FridgeItems.IndexOf(existingItem);
                        FridgeService.FridgeItems[index] = savedItem;
                    }
                    else
                    {
                        FridgeService.FridgeItems.Add(savedItem);
                    }

                    await SyncItemSubscriptionsAsync();

                    searchText = "";

                    recommendedRecipes.Clear();
                    hasSearchedRecipes = false;
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Fridge add error: {ex}");

                    FridgeService.ErrorMessage =
                        Localizer["ProductAddError"].Value;
                }
            }
        }
        finally
        {
            isDialogOpen = false;
        }
    }

    private async Task SearchRecipesAsync()
    {
        isSearchingRecipes = true;
        hasSearchedRecipes = false;
        recipesError = null;

        try
        {
            recommendedRecipes =
                await RecipesApiService.GetRecommendedRecipesAsync();

            hasSearchedRecipes = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Recipes loading error: {ex}");

            recipesError =
                Localizer["RecipesLoadError"].Value;
        }
        finally
        {
            isSearchingRecipes = false;
        }
    }

    private async Task DeleteIngredientAsync(FridgeItem item)
    {
        try
        {
            await ApiService.DeleteItemAsync(item.Id);

            FridgeService.FridgeItems.RemoveAll(
                x => x.Id == item.Id
            );

            await SyncItemSubscriptionsAsync();

            FridgeService.ErrorMessage = null;

            recommendedRecipes.Clear();
            hasSearchedRecipes = false;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Fridge delete error: {ex}");

            FridgeService.ErrorMessage =
                Localizer["ProductDeleteError"].Value;
        }
    }

    private async Task EditIngredientAsync(FridgeItem item)
    {
        var ingredient = FridgeService.Ingredients
            .FirstOrDefault(x =>
                x.Name.Equals(
                    item.Ingredient.Name,
                    StringComparison.OrdinalIgnoreCase));

        if (ingredient == null)
        {
            Console.WriteLine(
                $"Ingredient not found: {item.Ingredient.Name}");
            return;
        }

        var parameters = new DialogParameters<AddIngredientDialog>
        {
            { x => x.Ingredient, ingredient },
            { x => x.EditingItem, item }
        };

        var dialog = await DialogService.ShowAsync<AddIngredientDialog>(
            Localizer["EditProduct"].Value,
            parameters);

        var result = await dialog.Result;

        if (result == null ||
            result.Canceled ||
            result.Data is not FridgeItem updatedItem)
        {
            return;
        }

        try
        {
            await ApiService.UpdateItemAsync(updatedItem);

            var items = await ApiService.GetItemsAsync();

            FridgeService.FridgeItems.Clear();
            FridgeService.FridgeItems.AddRange(items);

            await SyncItemSubscriptionsAsync();

            recommendedRecipes.Clear();
            hasSearchedRecipes = false;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Fridge update error: {ex}");

            FridgeService.ErrorMessage =
                Localizer["ProductUpdateError"].Value;
        }
    }

    private void OpenRecipe(int recipeId)
    {
        Navigation.NavigateTo($"/recipes/{recipeId}");
    }

    private void HandleRecipeKeyDown(
        Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e,
        int recipeId)
    {
        if (e.Key == "Enter" || e.Key == " ")
        {
            OpenRecipe(recipeId);
        }
    }

    private async Task OnFridgeChangedAsync()
    {
        if (isDisposed)
            return;

        try
        {
            var items = await ApiService.GetItemsAsync();

            await InvokeAsync(async () =>
            {
                if (isDisposed)
                    return;

                FridgeService.FridgeItems.Clear();
                FridgeService.FridgeItems.AddRange(items);

                recommendedRecipes.Clear();
                hasSearchedRecipes = false;

                await SyncItemSubscriptionsAsync();

                StateHasChanged();
            });
        }
        catch (Exception ex)
        {
            Console.WriteLine($"SignalR fridge update error: {ex}");
        }
    }

    public async ValueTask DisposeAsync()
    {
        isDisposed = true;

        SignalRService.FridgeChanged -= OnFridgeChangedAsync;

        await SignalRService.DisposeAsync();
    }
}
